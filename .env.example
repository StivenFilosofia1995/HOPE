# HOPE — variables de entorno.
# Copiar a .env para desarrollo local. En Railway van en Variables del servicio.
# .env está en .gitignore y NO debe subirse nunca.

# URL del proyecto Supabase.
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave anónima. Es PÚBLICA por diseño: viaja al navegador y está protegida
# por Row Level Security, no por secreto. Es correcto que esté aquí.
SUPABASE_ANON_KEY=eyJ...

# ─────────────────────────────────────────────────────────────────────
# NO PONER AQUÍ LA SERVICE_ROLE KEY.
#
# Esa clave salta por completo el Row Level Security: quien la tenga lee,
# modifica y borra toda la base, incluida la tabla `contactos` con los datos
# personales. No la necesita ni el frontend ni este backend para funcionar.
# Si algún día hace falta para tareas de curaduría, va en un servicio aparte
# que no sirva HTML.
# ─────────────────────────────────────────────────────────────────────

# Puerto. Railway lo inyecta solo; en local, 8000.
PORT=8000
