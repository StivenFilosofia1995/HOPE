# HOPE — variables de entorno.
# Copiar a .env para desarrollo local. En Railway van en Variables del servicio.
# .env está en .gitignore y NO debe subirse nunca.

# URL del proyecto Supabase.
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave anónima. Es PÚBLICA por diseño: viaja al navegador y está protegida
# por Row Level Security, no por secreto. Es correcto que esté aquí.
SUPABASE_ANON_KEY=eyJ...

# ─────────────────────────────────────────────────────────────────────
# NO PONER AQUÍ LA SERVICE_ROLE KEY.
#
# Esa clave salta por completo el Row Level Security: quien la tenga lee,
# modifica y borra toda la base, incluida la tabla `contactos` con los datos
# personales. No la necesita ni el frontend ni este backend para funcionar.
# Si algún día hace falta para tareas de curaduría, va en un servicio aparte
# que no sirva HTML.
# ─────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────
# Llave de escritura de la capa de coordinación interna.
#
# Sin ella, cualquiera con la URL pública podría crear, editar o BORRAR los
# apuntes internos. Leer el mapa y todas las fuentes de cortes sigue abierto
# en cualquier caso: son datos públicos.
#
# Comportamiento, seguro por defecto:
#   definida  → POST/PUT/DELETE exigen la cabecera X-HOPE-Token.
#   vacía     → solo se acepta escritura desde la propia máquina. Desde
#               internet se responde 503 explicando cómo activarla, así que
#               nunca queda abierta por olvido.
#
# Generar una:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# En Railway va en Variables del servicio, no en este archivo.
# ─────────────────────────────────────────────────────────────────────
HOPE_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Cloudflare Radar (OPCIONAL).
#
# Es la fuente más rápida que hay para tráfico de internet por país y por
# operador, y la única que publica cortes confirmados y anotados a mano.
# HOPE funciona sin esto: si la variable no está, esa sección dice que
# falta la llave y el resto sigue igual.
#
# Sacarla toma dos minutos y no pide tarjeta ni dominio:
#   dash.cloudflare.com → My Profile → API Tokens → Create Token
#   → Custom token → permiso «Account · Radar · Read»
# ─────────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=

# Puerto. Railway lo inyecta solo; en local, 8000.
PORT=8000
